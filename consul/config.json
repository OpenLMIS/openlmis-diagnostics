{
  "service": {
    "Name": "diagnostics",
    "Id": "diagnostics-service",
    "Port": 8080,
    "Tags": ["openlmis-service"],
    "check": {
      "interval": "10s",
      "http": "http://HOST:PORT/actuator/health",
      "timeout": "5s"
    }
  },
  "raml": "/consul/api-definition.yaml",
  "path": [
    "diagnostics",
    "diagnostics/docs",
    "diagnostics/docs/<all>",
    "diagnostics/webjars",
    "diagnostics/webjars/<all>"
  ]
}
